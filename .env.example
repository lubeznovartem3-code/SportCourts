# =====================================================================================
#  SportCourts — пример конфигурации сервера.
#  Скопируйте этот файл в .env (в корне репозитория) и заполните значения.
#  Файл .env содержит секреты и НЕ должен попадать в Git (он уже в .gitignore).
# =====================================================================================

# ---- Обязательные настройки ---------------------------------------------------------
# Строка подключения к PostgreSQL. Формат: postgresql+asyncpg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@АДРЕС:ПОРТ/БАЗА
# Если в пароле есть символы @ : / # ? % — замените их кодами (@ -> %40, : -> %3A, / -> %2F, # -> %23, ? -> %3F, % -> %25).
DATABASE_URL=postgresql+asyncpg://sportcourts:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/sportcourts

# Секретный ключ подписи токенов входа, не короче 32 символов. Сгенерируйте командой:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Если сменить ключ, все пользователи будут разлогинены.
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_KEY

# ---- Первый администратор (используется ТОЛЬКО командой: python -m app.cli create-admin) ----
# Если ADMIN_PASSWORD не задан, команда спросит пароль в консоли (так безопаснее).
# Если задан здесь, при первом входе потребуется сменить пароль; после создания удалите строку.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# ---- Запуск сервера -----------------------------------------------------------------
# production — боевой режим (документация API скрыта); development — для разработки.
APP_ENV=production
# 127.0.0.1 — сервер доступен только с этого компьютера (так и нужно при Cloudflare Tunnel).
# 0.0.0.0 — доступен из локальной сети (нужно только для отладки без туннеля).
HOST=127.0.0.1
PORT=8000
# От каких адресов принимать заголовки прокси (X-Forwarded-For). cloudflared работает на этом же ПК.
TRUSTED_PROXY_IPS=127.0.0.1

# ---- Каталоги (относительные пути считаются от корня репозитория) --------------------
# Фотографии пользователей и площадок. Хранятся отдельно от кода и базы данных.
UPLOADS_DIR=data/uploads
LOGS_DIR=data/logs
DATA_DIR=data
# Каталог резервных копий. Лучше указать путь на ДРУГОМ физическом диске, например D:\SportCourtsBackups
BACKUP_DIR=backups

# ---- Необязательные настройки (значения по умолчанию подходят для старта) --------------
LOG_LEVEL=INFO
# Размер одного файла лога (МБ) и число хранимых старых файлов: итого не больше (BACKUP_COUNT+1)*MB.
LOG_MAX_MB=5
LOG_BACKUP_COUNT=5

# Сессия входа действует столько дней, затем потребуется войти снова
ACCESS_TOKEN_DAYS=30
# Пользователь считается «в сети», если активен в течение этого числа секунд
ONLINE_TIMEOUT_SECONDS=120

# Изображения
MAX_UPLOAD_MB=5
MAX_REQUEST_MB=8
IMAGE_MAX_DIMENSION=1600
# Защита от «бомб»: изображения крупнее этого числа пикселей отклоняются
IMAGE_MAX_PIXELS=40000000
# Загруженные, но не прикреплённые к заявке фото удаляются через столько часов
STAGING_TTL_HOURS=24
AVATAR_MAX_DIMENSION=512
JPEG_QUALITY=82

# Присутствие и отчёты
PRESENCE_TTL_HOURS=3
PLAYER_REPORT_TTL_HOURS=6
PLAYER_REPORT_COOLDOWN_SECONDS=300
PLAYER_REPORT_MAX_PER_HOUR=20
# Сколько часов после начала игра ещё показывается в списке открытых
GAME_LIST_GRACE_HOURS=12
MAX_OPEN_GAMES_PER_USER=5
MAX_PENDING_SUBMISSIONS_PER_USER=5

# Защита от перебора паролей и спама
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
REGISTER_MAX_PER_IP=10
REGISTER_WINDOW_SECONDS=600
MESSAGE_MAX_PER_MINUTE=40

# База данных: размер пула соединений (для 5–20 пользователей хватает значений по умолчанию)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Резервное копирование и диск
# Папка bin установленного PostgreSQL, если pg_dump не найден автоматически (путь без кавычек), например:
# PG_BIN_DIR=C:\Program Files\PostgreSQL\17\bin
PG_BIN_DIR=
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_KEEP=3
# Предупреждать, если на диске свободно меньше этого числа гигабайт
MIN_FREE_DISK_GB=5
