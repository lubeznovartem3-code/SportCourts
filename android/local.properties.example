# Скопируйте этот файл в local.properties (он в .gitignore) и заполните.
# Android Studio сама добавит строку sdk.dir=... при открытии проекта.

# Ключ Yandex MapKit (получение: docs/MAPKIT.md). Без ключа приложение запустится, но карта будет пустой.
MAPKIT_API_KEY=

# Необязательно: адрес сервера по умолчанию (например https://что-то.trycloudflare.com).
# Его можно изменить в самом приложении без пересборки (Настройки -> Адрес сервера).
API_BASE_URL=
